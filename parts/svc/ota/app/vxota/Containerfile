# vxota — the OTA server (keygen/publish/serve), packaged for deployment via
# `vxedge ota up --experiment <manifest>` (ARCHITECTURE.md §8).
#
# Packaging-only: stage.sh puts the vxota v0.1.1 release binary (checksum verified) in bin/ first.
# UPSTREAM is the Debian runtime base, digest-pinned: the release binary needs glibc.
ARG UPSTREAM
FROM ${UPSTREAM}

RUN groupadd -r vxota && useradd -r -g vxota -s /usr/sbin/nologin -d /nonexistent vxota

COPY bin/vxota /usr/local/bin/vxota

USER vxota
ENTRYPOINT ["/usr/local/bin/vxota"]
