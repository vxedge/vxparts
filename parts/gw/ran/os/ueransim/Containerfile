# gw/ran/os/ueransim — UERANSIM gNB/UE simulator, containerized (pairs with gw/5gc/os/open5gs).
# Ported from vxedge/containers/fiveg/Containerfile.ueransim — same content, now built via
# vxparts' own publish pipeline. Built from the pinned upstream tag (see part.yaml) so
# nr-gnb/nr-ue versions ride the image digest into results metadata (§13).
#
# Also carries vxprobe, the vxagents release named in part.yaml, so a campaign's reflector can run
# inside a UE's own pod and network namespace. Run ./stage-release.sh first: it downloads that
# release, verifies the tarball's sha256 and stages the binary in bin/.
#
# Run:    podman run --rm <ref> nr-gnb -c /etc/vx5g/gnb.yaml
#         nr-ue needs NET_ADMIN + /dev/net/tun (creates uesimtunN);
#         SCTP comes from the HOST kernel: `modprobe sctp` once per boot.

ARG UPSTREAM
FROM ${UPSTREAM} AS build
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      make g++ cmake git ca-certificates libsctp-dev lksctp-tools \
 && rm -rf /var/lib/apt/lists/*
ARG UERANSIM_TAG=v3.2.7
RUN git clone --depth 1 --branch ${UERANSIM_TAG} \
      https://github.com/aligungr/UERANSIM /src/UERANSIM \
 && test "$(git -C /src/UERANSIM rev-parse HEAD)" = 1d1e154f869260b5e98f6905827b1bd9b8663afc
RUN cd /src/UERANSIM && make -j"$(nproc)"

FROM ${UPSTREAM}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libsctp1 lksctp-tools iproute2 iputils-ping \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/UERANSIM/build/nr-gnb /usr/local/bin/nr-gnb
COPY --from=build /src/UERANSIM/build/nr-ue /usr/local/bin/nr-ue
COPY --from=build /src/UERANSIM/build/nr-cli /usr/local/bin/nr-cli
COPY bin/vxprobe /usr/local/bin/vxprobe
RUN mkdir -p /etc/vx5g

ENTRYPOINT []
CMD ["bash", "-c", "nr-gnb --version; nr-ue --version; vxprobe --version"]
