# vxprobe reflector: the payload of a container node that answers vxedge's flow probes on :9800,
# with busybox for the flow checks' shell and wget. Packaging-only: stage.sh puts the vxagents
# release binary in bin/ first.
ARG UPSTREAM
FROM docker.io/library/busybox:1.37.0-musl@sha256:5624bb6777cf469b1fb50ae3f981b15d2715ee2fffaf20b9998cfb7843726835 AS busybox
FROM ${UPSTREAM}
COPY --from=busybox /bin/busybox /bin/busybox
COPY bin/vxprobe /vxprobe
ENTRYPOINT ["/vxprobe", "reflect"]
